# Copy to .env and fill in values. Do not commit .env.

# --- Slack (ingest.sh, common.sh slack_notify, ingest-watchdog.sh) ---
# Bot token used for chat.postMessage. On the ingest EC2 this lives in
# /home/ec2-user/ingestion3/.env. GitHub Actions uses repository secrets
# of the same names instead.
SLACK_BOT_TOKEN=
# Optional channel ID; defaults to C02HEU2L3 (#tech-alerts).
SLACK_CHANNEL=

# --- Slack (Python orchestrator and staged report only, scheduler/orchestrator/) ---
# Slack Incoming Webhook URL for #tech-alerts (create in Slack: Settings → Integrations → Incoming Webhooks)
SLACK_WEBHOOK=your_webhook_url_here

# Slack Incoming Webhook URL for #tech (hub-complete success notifications with @here)
# If not set, hub-complete messages fall back to SLACK_WEBHOOK.
SLACK_TECH_WEBHOOK=your_tech_channel_webhook_url_here

# Slack User ID to @mention in orchestrator escalation alerts (e.g. U01234ABCD).
# Find via Slack: Profile → More → Copy member ID.
SLACK_ALERT_USER_ID=

# --- AWS ---
# Not needed on the ingest EC2 (instance role) or in GitHub Actions (OIDC role).
# Locally, set this unless your default AWS profile is the DPLA account: only
# the ingest_python_scripts launchers fall back to "dpla"; shell scripts and
# raw aws commands use your default credentials.
# AWS_PROFILE=dpla

# --- Paths ---
# Data root for pipeline output (default: $HOME/dpla/data).
# DPLA_DATA=/path/to/data
# Path to i3.conf (default: $HOME/dpla/code/ingestion3-conf/i3.conf).
# I3_CONF=/path/to/ingestion3-conf/i3.conf

# Java 11+ required (java.net.http used in HttpUtils). Java 19 is known to work.
# Find available JDKs: /usr/libexec/java_home -V (macOS)
JAVA_HOME=/path/to/java-11-or-newer

# For use of the python run scripts, fill out the following.
INGESTION3_CONF_REPO=/path/to/repo

INGESTION3_REPO=/path/to/repo

BATCH_REPO_DIR=/path/to/repo

# Ingest EC2 instance ID used by the ingest_python_scripts launchers
# (GitHub Actions passes it as a secret).
# INGEST_INSTANCE_ID=
